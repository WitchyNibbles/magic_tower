# Copy to .env before connecting Microsoft Graph.
# Never commit real tenant, client, or user identifiers.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////data/workboard.db
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TARGET_USER_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8787/api/auth/callback
# Generate once with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# This key encrypts the local Graph token store and message excerpts stored in the
# database. Without it the API refuses to store or serve them. Keep it out of source control.
APP_ENCRYPTION_KEY=
# Addresses whose mail the promotion heuristic always treats as work, comma-separated.
# For an internal robot whose output you act on but whose mail the rules reject.
PROMOTION_ALLOWLISTED_SENDERS=
# Required for installed Codex/Claude agent protocol operations. This is a
# local API credential, not a Microsoft Graph secret. Generate separately.
LOCAL_API_TOKEN=
# Jira: a classic API token (https://id.atlassian.com/manage-profile/security/api-tokens),
# not a scoped token -- Basic auth as email:token against https://<site>.atlassian.net.
JIRA_SITE_URL=
JIRA_ACCOUNT_EMAIL=
JIRA_API_TOKEN=
# Optional: a project key that syncs browse-only for management visibility.
# Its issues are never promoted into the actionable queue.
JIRA_MANAGEMENT_PROJECT_KEY=
